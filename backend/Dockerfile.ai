# Use PyTorch base image with CUDA support
FROM pytorch/pytorch:2.1.0-cuda11.8-cudnn8-runtime

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Install system dependencies for OpenCV and other AI processing bindings
RUN apt-get update && apt-get install -y \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Install AI Python dependencies
COPY requirements.ai.txt .
RUN pip install --upgrade pip && \
    pip install --no-cache-dir -r requirements.ai.txt

# Copy application files (specifically the ai_service directory)
COPY ai_service/ ./ai_service/
COPY .env .

# Expose internal microservice port
EXPOSE 8001

# Run the inference service
CMD ["uvicorn", "ai_service.main:app", "--host", "0.0.0.0", "--port", "8001"]
