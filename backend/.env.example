# App
APP_NAME="Lung Disease Detection API"
DEBUG=false

# Database
DATABASE_URL=postgresql+asyncpg://user:password@postgres:5432/lungdb
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET_KEY=replace_this_with_a_secure_random_64_character_string_for_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# OTP
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=3

# Field Encryption (AES-256)
FIELD_ENCRYPTION_KEY=replace_this_with_a_base64_encoded_32_byte_key_for_production=

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_IMAGES=xray-images
MINIO_BUCKET_REPORTS=reports
MINIO_SECURE=false  # true in production (HTTPS MinIO)
PRESIGNED_URL_EXPIRE_SECONDS=900

# AI Service
AI_SERVICE_URL=http://ai_service:8001
AI_INFERENCE_TIMEOUT_SECONDS=12
AI_INTERNAL_API_KEY=replace_this_with_a_random_internal_api_key

# Email
SENDGRID_API_KEY=replace_with_sendgrid_key
EMAIL_FROM=noreply@yourdomain.com

# Backup
BACKUP_BUCKET=db-backups
BACKUP_RETENTION_DAYS=180
