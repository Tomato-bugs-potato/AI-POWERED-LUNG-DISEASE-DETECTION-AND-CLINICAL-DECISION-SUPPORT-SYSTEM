# AI-Powered Lung Disease Detection — Frontend Environment

NEXT_PUBLIC_API_URL=http://<YOUR_EC2_PUBLIC_IP>:8000/api/v1

NEXT_PUBLIC_MINIO_URL=https://s3.amazonaws.com

NEXT_PUBLIC_APP_NAME="LungDetect AI"
NEXT_PUBLIC_APP_VERSION=1.0.0

NEXT_PUBLIC_DEFAULT_LANGUAGE=en
NEXT_PUBLIC_ENABLE_GRADCAM=true
NEXT_PUBLIC_ENABLE_ONBOARDING=true

NEXT_PUBLIC_EMAILJS_SERVICE_ID="xxxxxxxxxxx"
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID="xxxxxxxx"
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY="xxxxxxxxxx"
